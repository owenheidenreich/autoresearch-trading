<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autoresearch.tracka.capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gduby/.autoresearch-trading/runtime-venv/bin/python</string>
    <string>/Users/gduby/.autoresearch-trading/tracka/python_tracka_launcher.py</string>
    <string>--declaration</string>
    <string>REQUIRES_NEW_CAPTURE_DECLARATION.json</string>
    <string>--authorization</string>
    <string>REQUIRES_NEW_CAPTURE_AUTHORIZATION.json</string>
    <string>--window</string>
    <string>open</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>AUTORESEARCH_REPO_ROOT</key><string>/Users/gduby/Documents/autoresearch-trading</string></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>/Users/gduby/.autoresearch-trading/tracka/logs/python-direct.open.err</string>
  <key>StandardOutPath</key><string>/Users/gduby/.autoresearch-trading/tracka/logs/python-direct.open.out</string>
</dict>
</plist>
