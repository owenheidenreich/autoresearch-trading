v3/artifacts/layer2_unified_policy_*/seed_*/oof_predictions.pkl
v3/artifacts/layer2_unified_policy_*/seed_*/window_*/
v3/artifacts/layer3_unified_*/
v3/artifacts/golden_day_trace/
v3/artifacts/golden_day_training_trace/
# Trajectory data (large, generated by collect_trajectories)
v2/trajectories/*.pt
# Archive model files
archive/**/*.pt
archive/**/*.pt.*
