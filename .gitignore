archive/**/*.pt
archive/**/*.pt.*
# Working model candidate (downloaded during experiments)
v2/model_candidate.pt
# NOTE: v2/artifacts/*/model.pt is NOT excluded -- commit these as permanent record
*.pyc
__pycache__/
.venv/
*.egg-info/
dist/
build/
uv.lock

# Data cache
data/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store

