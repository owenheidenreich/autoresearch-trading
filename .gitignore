# Model checkpoints (large binaries, never commit)
v2/models/*.pt
v2/model.pt
v2/model_candidate.pt
# Data files (large, never commit)
v2/data*.pt
v2/data*.pt.*
# Per-day sidecar data (generated by build pipeline, ~1000 binary files)
v2/data_sidecars/*.pt
# Experiment artifacts (model weights are large binaries; manifests/snapshots stay)
v2/artifacts/*/model.pt
v2/artifacts/**/model.pt

# v3 large artifacts: reproducible from dataset + code recipe; do not commit.
# Markdown findings under v3/reference/ + small JSONs under v3/artifacts/side_prior_audit/
# carry the durable evidence for these runs.
v3/artifacts/layer2_action_surface_dataset*.pkl
v3/artifacts/simulated_l3_oracle_*.npz
v3/artifacts/layer2_unified_policy_*/manifest.json
v3/artifacts/layer2_unified_policy_*/seed_*/chosen_trades.pkl
