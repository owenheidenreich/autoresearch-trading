{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch-trading.local/research_ops/assumption_registry.schema.json",
  "title": "Research Ops Assumption Registry Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "priority",
    "layer",
    "assumption",
    "current_evidence",
    "risk_if_false",
    "falsification_test",
    "confidence_increases_if",
    "confidence_collapses_if",
    "required_artifacts",
    "blocked_actions",
    "status",
    "next_diagnostic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^A[0-9]{3}$"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "layer": {
      "type": "string",
      "minLength": 1
    },
    "assumption": {
      "type": "string",
      "minLength": 1
    },
    "current_evidence": {
      "type": "string"
    },
    "risk_if_false": {
      "type": "string"
    },
    "falsification_test": {
      "type": "string"
    },
    "confidence_increases_if": {
      "type": "string"
    },
    "confidence_collapses_if": {
      "type": "string"
    },
    "required_artifacts": {
      "type": "string"
    },
    "blocked_actions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["open", "partially_tested", "supported", "falsified", "accepted_risk", "blocked"]
    },
    "next_diagnostic": {
      "type": "string"
    }
  }
}
