{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch-trading.local/research_ops/iteration_manifest.schema.json",
  "title": "Research Ops Iteration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iteration_id",
    "assumption_id",
    "title",
    "status",
    "created_at",
    "owner_role",
    "blocked_actions",
    "allowed_paths",
    "forbidden_paths",
    "expected_outputs"
  ],
  "properties": {
    "iteration_id": {
      "type": "string",
      "pattern": "^ITER-[0-9]{3}_[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "assumption_id": {
      "type": "string",
      "pattern": "^A[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "verifying", "decision_pending", "completed", "closed", "blocked"]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
